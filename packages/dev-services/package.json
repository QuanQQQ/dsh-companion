{
  "name": "dsh-dev-services",
  "version": "0.2.0-rc.2",
  "private": true,
  "description": "Project Workspace-scoped development services with independent Linux supervision",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "dsh": "0.2.1-rc.5"
  },
  "main": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:systemd": "DEV_SERVICES_SYSTEMD_TEST=1 node --test tests/*.test.mjs",
    "check": "npm run test && npm run build"
  }
}
