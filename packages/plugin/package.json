{
  "name": "dsh-companion",
  "version": "0.1.2",
  "description": "Task-scoped localhost forwarding through paired macOS Companion devices",
  "type": "module",
  "main": "lib/host.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/host.mjs" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "CONTEXT.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-settings"],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsdown --config tsdown.config.ts",
    "dev:client": "tsdown --watch --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.spec.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepare": "pnpm build",
    "prepack": "pnpm check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "cordis": "^4.0.0-rc.7",
    "dsh-better-sidebar": "^0.13.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": { "optional": true }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.5.13",
    "dsh-better-sidebar": "0.13.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
